{
  "uid": "zeromttr-target-workload",
  "title": "ZeroMTTR — $service Performance & Remediation",
  "tags": ["zeromttr", "aiops", "otel", "lgtm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Target Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
        "definition": "label_values(http_request_duration_seconds_count, service)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_request_duration_seconds_count, service)"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": false,
        "iconColor": "#f43f5e",
        "name": "ZeroMTTR Incidents",
        "tags": ["zeromttr"],
        "type": "tags"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "p95 / p50 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])) by (le)) * 1000",
          "legendFormat": "p95 latency (ms)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])) by (le)) * 1000",
          "legendFormat": "p50 latency (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "always",
            "pointSize": 4
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 250 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "DB Connection Pool (Active vs Waiting — Optional)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "db_pool_used{service=\"$service\"}",
          "legendFormat": "Active ({{version}})"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "db_pool_waiting{service=\"$service\"}",
          "legendFormat": "Waiting ({{version}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "showPoints": "always",
            "pointSize": 4
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Pool Active Gauge (Optional)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "max(db_pool_used{service=\"$service\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "red", "value": 9 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "p95 Latency Gauge",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])) by (le)) * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 2000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 250 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP Throughput (req/s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "sum(rate(http_request_duration_seconds_count{service=\"$service\"}[1m]))"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      }
    },
    {
      "id": 6,
      "title": "Queued Pool Waiters (Optional)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "max(db_pool_waiting{service=\"$service\"})"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Latency Percentiles Comparison (p50 / p90 / p95 / p99)",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])) by (le)) * 1000",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])) by (le)) * 1000",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])) by (le)) * 1000",
          "legendFormat": "p95"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])) by (le)) * 1000",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 250 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    }
  ]
}
