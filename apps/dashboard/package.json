    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@primeuix/themes": "^1.0.0",
    "@zeromttr/utils": "workspace:^",
    "primeicons": "^7.0.0",
    "primeng": "^22.1.4",
    "rxjs": "^7.8.1",
    "tailwindcss": "^4.0.6",
    "zone.js": "~0.15.0"
  }
}
