{
  "name": "@zeromttr/dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "mock": "pnpm --filter @zeromttr/utils run build && pnpm dlx tsx mock-server/index.ts",
    "dev": "pnpm dlx vite",
    "start": "pnpm run mock & pnpm run dev"
  },
  "devDependencies": {
