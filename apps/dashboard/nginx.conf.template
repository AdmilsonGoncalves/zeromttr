server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Restaura IP real do visitante vindo de proxies confiáveis (Traefik / Docker bridge)
    # e descarta cabeçalhos forjados antes de repassar X-Real-IP / X-Forwarded-For ao orquestrador
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;

    # Proxy reverso interno apenas para /api/* -> orchestrator:8080 (nunca expõe /webhook/*)
    location /api/ {
        set $orchestrator_upstream http://orchestrator:8080;
        proxy_pass $orchestrator_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "Bearer ${DASHBOARD_API_TOKEN}";

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
        add_header X-Accel-Buffering "no" always;
        add_header Cache-Control "no-cache, no-transform" always;
    }

    location = /index.html {
        sub_filter '__ZEROMTTR_DOCS_DOMAIN__' '${ZEROMTTR_DOCS_DOMAIN}';
        sub_filter_once on;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
