{
  "name": "@zeromttr/docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start --port 4300 --locale pt-BR",
    "start:pt": "docusaurus start --port 4300 --locale pt-BR",
    "start:en": "docusaurus start --port 4300 --locale en-US",
    "start:es": "docusaurus start --port 4300 --locale es-ES",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 4300",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
