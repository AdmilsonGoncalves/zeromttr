{
  "name": "zeromttr",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "check:workspace": "prettier --check . && nx run-many -t lint,typecheck,test,build --parallel=4",
    "lint:workspace": "nx run-many -t lint",
    "test:workspace": "nx run-many -t test",
    "build:workspace": "nx run-many -t build",
    "dashboard:mock": "pnpm --filter @zeromttr/utils --filter @zeromttr/contracts run build && pnpm --filter @zeromttr/dashboard run mock",
    "dashboard:dev": "pnpm --filter @zeromttr/dashboard run dev",
    "dashboard:start": "pnpm --filter @zeromttr/utils --filter @zeromttr/contracts run build && (pnpm --filter @zeromttr/dashboard run mock & pnpm --filter @zeromttr/dashboard run dev)",
    "docs:build": "pnpm --filter @zeromttr/docs run build",
    "docs:serve": "pnpm --filter @zeromttr/docs run serve",
    "docs:start": "pnpm --filter @zeromttr/docs run start",
    "docs:start:pt": "pnpm --filter @zeromttr/docs run start:pt",
    "docs:start:en": "pnpm --filter @zeromttr/docs run start:en",
    "docs:start:es": "pnpm --filter @zeromttr/docs run start:es"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.20.0",
    "@nx/js": "^23.2.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9.20.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nx": "23.3.1",
    "prettier": "^3.5.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.24.1",
    "vitest": "catalog:"
  }
}
