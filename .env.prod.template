# ==============================================================================
# ZeroMTTR — Autonomous AIOps & Incident Remediation Engine
# Trilha: Logística & Automação (Automação de Fluxos Operacionais e Integração entre Sistemas)
# Engineered by AGJ Works (https://agjworks.com)
#
# Destino na VPS Linux:   /path/to/secrets/.env (caminho de exemplo fora do repositório)
# Permissões na VPS:      sudo mkdir -p /path/to/secrets
#                         sudo chown $VPS_USER:$VPS_USER /path/to/secrets/.env
#                         chmod 600 /path/to/secrets/.env
# Desenvolvimento local:  .env (na raiz do monorepo, baseado em .env.example)
# Regra de sintaxe:       nunca usar comentários inline na mesma linha do valor
# ==============================================================================

# --- 1. Domínio, Traefik & URLs Públicas (AGJ Works) ---
ZEROMTTR_DOMAIN=zeromttr.agjworks.com
TRAEFIK_NETWORK_NAME=traefik_default
PUBLIC_BASE_URL=https://zeromttr.agjworks.com
PUBLIC_DASHBOARD_URL=https://zeromttr.agjworks.com

# --- 2. Integrações Externas (GitHub API & Resend) ---
# Fine-grained PAT com permissões Contents (Read/Write) e Pull Requests (Read/Write) no repositório
GITHUB_TOKEN=coloque_seu_github_pat_aqui
TARGET_GITHUB_REPO=https://github.com/AdmilsonGoncalves/zeromttr
TARGET_BASE_BRANCH=release/target-v2.14.8
TARGET_SERVICE_PATH=apps/target-app-demo

# Resend (Domínio verificado: send.zeromttr.agjworks.com — Região: sae1 São Paulo)
RESEND_API_KEY=coloque_sua_chave_resend_aqui
RESEND_FROM="ZeroMTTR - AGJ Works <sre@zeromttr.agjworks.com>"
ON_CALL_ENGINEER_EMAIL=admilson@agjworks.com

# --- 3. Provedor de LLM do Orquestrador (ReasoningPort — Modelo Parametrizável) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=coloque_sua_chave_gemini_aqui

# --- 4. Segregação de Tokens de Segurança & Proteção de Cota ---
# Dica: gere cada segredo com `openssl rand -hex 24`
# Token exclusivo para comunicação Orchestrator -> MCP Server
MCP_AUTH_TOKEN=gere_com_openssl_rand_hex_24
# Token exclusivo para POST /webhook/grafana-alert (Grafana -> Orchestrator)
GRAFANA_WEBHOOK_TOKEN=gere_com_openssl_rand_hex_24
# Token injetado pelo Nginx apenas nas rotas /api/* do Dashboard
DASHBOARD_API_TOKEN=gere_com_openssl_rand_hex_24
# Assina exclusivamente os links de Aprovar/Rejeitar enviados por e-mail via Resend
DECISION_HMAC_SECRET=gere_com_openssl_rand_hex_24
# Exige chave para acionar o modo Live API na VPS pública (visitantes sem chave assistem ao Replay gravado)
LIVE_DEMO_KEY=gere_com_openssl_rand_hex_16
# Cooldown global de 2 min entre simulações
SIMULATION_COOLDOWN_MS=120000

# --- 5. Observabilidade Interna (Rede Docker aiops-net) ---
GRAFANA_ADMIN_USER=admilson
GRAFANA_ADMIN_PASSWORD=gere_uma_senha_forte_aqui
# Token de Service Account com papel Editor (para POST /api/annotations);
# se deixado vazio, o adapter usa fallback para Basic Auth (GRAFANA_ADMIN_USER:GRAFANA_ADMIN_PASSWORD)
GRAFANA_SA_TOKEN=
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
GRAFANA_URL=http://grafana:3000

# --- 6. Conectividade Interna dos Containers ---
MCP_URL=http://mcp-server:8000
TARGET_DEMO_URL=http://target-app-demo:3001
DATABASE_URL=postgres://zeromttr:zeromttr@postgres:5432/payments

# --- 7. Flags do Simulador de Caos ---
CHAOS_ENABLED=true
DEMO_MODE=true
