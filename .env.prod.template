# ==============================================================================
# ZeroMTTR — Autonomous AIOps & Incident Remediation Engine
# Track: Logistics & Automation (Operational Workflow Automation & Critical System Integrations)
# Engineered by AGJ Works (https://agjworks.com)
#
# Production VPS Destination: /path/to/secrets/.env (example path outside repository)
# VPS Permissions:            sudo mkdir -p /path/to/secrets
#                             sudo chown $VPS_USER:$VPS_USER /path/to/secrets/.env
#                             chmod 600 /path/to/secrets/.env
# Local Development:          .env (at monorepo root, based on .env.example)
# Syntax Rule:                Never use inline comments on the same line as a value
# ==============================================================================

# --- 1. Domain, Traefik & Public URLs (AGJ Works) ---
ZEROMTTR_DOMAIN=zeromttr.agjworks.com
TRAEFIK_NETWORK_NAME=traefik_default
PUBLIC_BASE_URL=https://zeromttr.agjworks.com
PUBLIC_DASHBOARD_URL=https://zeromttr.agjworks.com

# --- 2. External Integrations (GitHub API & Resend) ---
# Fine-grained PAT with Contents (Read/Write) and Pull Requests (Read/Write) permissions
GITHUB_TOKEN=replace_with_your_github_pat
TARGET_GITHUB_REPO=https://github.com/AdmilsonGoncalves/zeromttr
TARGET_BASE_BRANCH=release/target-v2.14.8
TARGET_SERVICE_PATH=apps/target-app-demo

# Resend (Verified domain: send.zeromttr.agjworks.com — Region: sae1 São Paulo)
RESEND_API_KEY=replace_with_your_resend_api_key
RESEND_FROM="ZeroMTTR - AGJ Works <sre@send.zeromttr.agjworks.com>"
ON_CALL_ENGINEER_EMAIL=oncall-sre@example.com

# --- 3. Orchestrator LLM Provider (ReasoningPort — Configurable Model) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=replace_with_your_gemini_api_key

# --- 4. Security Token Segregation & Quota Protection ---
# Tip: generate each secret with `openssl rand -hex 24`
# Dedicated token for Orchestrator -> MCP Server communication
MCP_AUTH_TOKEN=generate_with_openssl_rand_hex_24
# Dedicated token for POST /webhook/grafana-alert (Grafana -> Orchestrator)
GRAFANA_WEBHOOK_TOKEN=generate_with_openssl_rand_hex_24
# Token injected by Nginx only for Dashboard /api/* routes
DASHBOARD_API_TOKEN=generate_with_openssl_rand_hex_24
# Exclusively signs Approve/Reject decision links sent via Resend email
DECISION_HMAC_SECRET=generate_with_openssl_rand_hex_24
# Required key to trigger real Live API mode on public VPS (anonymous visitors see recorded Replay)
LIVE_DEMO_KEY=generate_with_openssl_rand_hex_16
# Global 2-minute cooldown between simulations
SIMULATION_COOLDOWN_MS=120000

# --- 5. Internal Observability (Docker internal aiops-net network) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_strong_password_here
# Service Account token with Editor role (for POST /api/annotations);
# if left blank, the adapter falls back to Basic Auth (GRAFANA_ADMIN_USER:GRAFANA_ADMIN_PASSWORD)
GRAFANA_SA_TOKEN=
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
GRAFANA_URL=http://grafana:3000

# --- 6. Container Internal Connectivity ---
MCP_URL=http://mcp-server:8000
TARGET_DEMO_URL=http://target-app-demo:3001
POSTGRES_USER=zeromttr
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=payments
DATABASE_URL=postgres://zeromttr:generate_strong_password_here@postgres:5432/payments

# --- 7. Chaos Simulator Flags ---
CHAOS_ENABLED=true
DEMO_MODE=true
